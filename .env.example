# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
# Before you verify a domain, use Resend's shared test sender (sends only to your Resend account email):
FROM_EMAIL=Dad Tales <onboarding@resend.dev>
# After domain verify: FROM_EMAIL=Dad Tales <questions@yourdomain.com>
# Receiving subdomain so Reply doesn't hit your root MX / portfolio mail:
REPLY_TO_EMAIL=questions@reply.yourdomain.com
DAD_EMAIL=dad@example.com
# Must be the same email as your Resend account when using onboarding@resend.dev
TEST_EMAIL=you@example.com
NOTIFY_EMAIL=you@example.com

# Security (generate random strings)
CRON_SECRET=your-cron-secret
EXPORT_SECRET=your-export-secret

# Optional
# SUPABASE_STORAGE_BUCKET=answer-photos
