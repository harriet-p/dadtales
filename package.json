{
  "name": "dadtales",
  "version": "1.0.0",
  "private": true,
  "description": "Weekly question email tool — send, capture replies, export for book layout",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "send": "tsx scripts/send-question.ts",
    "email:preview": "tsx scripts/preview-email.ts",
    "export": "tsx scripts/export.ts",
    "export:md": "tsx scripts/export.ts --format markdown",
    "export:json": "tsx scripts/export.ts --format json",
    "test": "node --import tsx --test lib/**/*.test.ts"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@supabase/supabase-js": "^2.49.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.17",
    "@vercel/node": "^5.1.8",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
